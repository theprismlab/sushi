# Staging. Tracks origin/develop.
#
# WARNING: there is only one Jenkins job, so a build launched from the develop
# instance is a real pipeline run that writes into the real build directory.
# This is not a sandbox. The UI shows an amber banner to make that obvious.
SUSHI_ENV=develop
PORT=8101

JENKINS_URL=http://localhost:8080
JENKINS_JOB_PATH=job/sushi

PRISMSEQ_ROOT=/cmap/obelix/pod/prismSeq

# Separate database: staging runs must not pollute the production run history.
SUSHI_UI_DB=/local/jenkins/sushi_ui_develop.db
