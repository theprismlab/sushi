// Deploys the sushi UI. One Jenkins job per environment, both using this file:
//
//   sushi-ui-develop  -> SCM branch develop, serves :8101
//   sushi-ui-main     -> SCM branch main,    serves :8100
//
// The environment is derived from the checked-out branch, so the two jobs
// differ only in their SCM configuration. Nothing here needs root: Jenkins
// already runs as a user with podman and the obelix mount.
//
// The UI runs as a detached podman container rather than a systemd unit,
// because we have no sudo on this VM. Consequences worth knowing:
//   - Reboots do not bring it back, so the cron trigger below re-runs the job
//     as a safety net. The job is idempotent and cheap when nothing changed.
//   - Jenkins' ProcessTreeKiller would reap conmon when the build ends, which
//     is what JENKINS_NODE_COOKIE=dontKillMe prevents.
//
// Running under Jenkins is also what makes the archive step work: build
// directories are espresso-owned and mode 755, so a stale config.json can only
// be moved aside by espresso. Jenkins runs as espresso, and rootless podman
// maps container root to the invoking user, so writes land as espresso.
//
// NOTE: :8100 is currently held by a hand-started instance out of
// /local/jenkins/sushi-ui (see bin/sushi-ui there). Stop that before the first
// run of sushi-ui-main, or --network=host cannot bind and the deploy will fail
// its health check and roll back. :8101 is free, so develop can go first.

def ENVIRONMENTS = [
    main   : [name: 'production', port: '8100', volume: 'sushi-ui-db-main'],
    develop: [name: 'develop',    port: '8101', volume: 'sushi-ui-db-develop'],
]

pipeline {
    agent any

    parameters {
        booleanParam(name: 'FORCE_REDEPLOY', defaultValue: false,
                     description: 'Rebuild and restart even if the running container is already on this commit.')
    }

    triggers {
        pollSCM('H/2 * * * *')
        // Safety net: restarts the container after a VM reboot, and catches a
        // missed poll. Exits in seconds when the deployment is already current.
        cron('H/15 * * * *')
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        PODMAN = '/usr/bin/podman'
    }

    stages {
        stage('Identify') {
            steps {
                script {
                    // GIT_BRANCH is "origin/develop" for a plain pipeline job and
                    // "develop" for multibranch; BRANCH_NAME only exists for the latter.
                    def raw = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
                    def branch = raw.replaceFirst(/^origin\//, '').trim()

                    if (!ENVIRONMENTS.containsKey(branch)) {
                        error("No environment defined for branch '${branch}'. " +
                              "This job must track one of ${ENVIRONMENTS.keySet()}.")
                    }

                    env.DEPLOY_BRANCH = branch
                    env.DEPLOY_ENV = ENVIRONMENTS[branch].name
                    env.DEPLOY_PORT = ENVIRONMENTS[branch].port
                    env.DEPLOY_VOLUME = ENVIRONMENTS[branch].volume
                    env.CONTAINER = "sushi-ui-${branch}"
                    env.COMMIT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.IMAGE = "localhost/sushi-ui:${branch}-${env.COMMIT}"

                    // What is live right now, so we can skip a no-op deploy and
                    // roll back to it if the new one is unhealthy.
                    env.LIVE_COMMIT = sh(
                        script: """${PODMAN} inspect -f '{{index .Config.Labels "sushi.commit"}}' ${env.CONTAINER} 2>/dev/null || true""",
                        returnStdout: true).trim()
                    env.LIVE_IMAGE = sh(
                        script: """${PODMAN} inspect -f '{{.Image}}' ${env.CONTAINER} 2>/dev/null || true""",
                        returnStdout: true).trim()
                    env.RUNNING = sh(
                        script: "${PODMAN} ps --filter name=^${env.CONTAINER}\$ --filter status=running -q",
                        returnStdout: true).trim() ? 'yes' : 'no'
                    // With --network=host our own container occupies the port, so
                    // "port bound but our container is not running" means someone
                    // else has it -- and uvicorn will die on EADDRINUSE while a
                    // health check still gets answered by whatever is squatting.
                    env.PORT_BOUND = sh(
                        script: "(ss -lnt 2>/dev/null || true) | grep -q ':${env.DEPLOY_PORT} ' && echo yes || echo no",
                        returnStdout: true).trim()

                    echo "${branch} -> ${env.DEPLOY_ENV} on :${env.DEPLOY_PORT}"
                    echo "target ${env.COMMIT}; live ${env.LIVE_COMMIT ?: 'nothing'} (running: ${env.RUNNING})"

                    if (env.RUNNING == 'no' && env.PORT_BOUND == 'yes') {
                        error("""Port ${env.DEPLOY_PORT} is already bound, but ${env.CONTAINER} is not \
running -- so something else holds it. Deploying would start a container that dies on \
EADDRINUSE while /api/health keeps answering from the squatter. Stop that process first \
(if it is the hand-started instance: /local/jenkins/sushi-ui/bin/sushi-ui stop as espresso).""")
                    }

                    env.SKIP = (env.RUNNING == 'yes' && env.LIVE_COMMIT == env.COMMIT
                                && !params.FORCE_REDEPLOY) ? 'yes' : 'no'
                    if (env.SKIP == 'yes') {
                        echo 'Already deployed and running. Nothing to do.'
                    }
                }
            }
        }

        stage('Build image') {
            when { environment name: 'SKIP', value: 'no' }
            steps {
                sh '${PODMAN} build -t ${IMAGE} -f ui/Dockerfile ui'
            }
        }

        stage('Redeploy') {
            when { environment name: 'SKIP', value: 'no' }
            steps {
                script {
                    startContainer(env.IMAGE)
                }
            }
        }

        stage('Health check') {
            steps {
                script {
                    if (healthyAt(env.COMMIT)) {
                        echo "${env.DEPLOY_ENV} healthy on :${env.DEPLOY_PORT} at ${env.COMMIT}"
                        return
                    }
                    diagnose()
                    if (env.SKIP == 'yes') {
                        error("Container is running but :${env.DEPLOY_PORT} is not serving ${env.COMMIT}.")
                    }

                    // An unattended deploy must not be able to leave an
                    // environment dead.
                    if (!env.LIVE_IMAGE) {
                        error("${env.COMMIT} is unhealthy and there is no previous image to fall back to.")
                    }
                    echo "Unhealthy. Rolling back to ${env.LIVE_COMMIT ?: env.LIVE_IMAGE}."
                    startContainer(env.LIVE_IMAGE, env.LIVE_COMMIT)
                    if (healthyAt(env.LIVE_COMMIT)) {
                        error("Rolled back to ${env.LIVE_COMMIT}; ${env.COMMIT} was NOT deployed.")
                    }
                    error("Rollback also failed. ${env.DEPLOY_ENV} is down and needs a human.")
                }
            }
        }
    }

    post {
        always {
            // Dangling images only; tagged per-commit images are the rollback path.
            sh '${PODMAN} image prune -f || true'
            sh '${PODMAN} ps --filter name=sushi-ui- --format "{{.Names}}\t{{.Status}}\t{{.Image}}" || true'
        }
    }
}

/** Replace the running container with one from the given image. */
void startContainer(String image, String commitLabel = null) {
    def commit = commitLabel ?: env.COMMIT
    sh """
        ${PODMAN} rm -f ${env.CONTAINER} 2>/dev/null || true

        # --network=host: the UI has to reach Jenkins on localhost:8889, and it
        #   also publishes DEPLOY_PORT without a rootless port mapping.
        # JENKINS_NODE_COOKIE: stops ProcessTreeKiller reaping conmon when this
        #   build finishes, which would kill the container.
        # .clue_api_key: mounted read-only at the same path the host uses, so
        #   CLUE_API_KEY_FILE needs no override. Same mount launch_job.sh gives
        #   the pipeline containers. Without it the cellDB lookups that populate
        #   CONTROL_BARCODE_META fail with ENOENT even though the file exists --
        #   the hand-started instance ran on the host, where the path resolved.
        JENKINS_NODE_COOKIE=dontKillMe ${PODMAN} run -d \
          --name ${env.CONTAINER} \
          --network=host \
          --label sushi.commit=${commit} \
          --label sushi.branch=${env.DEPLOY_BRANCH} \
          -e SUSHI_ENV=${env.DEPLOY_ENV} \
          -e SUSHI_SERVICE_ACCOUNT=\$(id -un) \
          -e SUSHI_COMMIT=${commit} \
          -e SUSHI_BRANCH=${env.DEPLOY_BRANCH} \
          -e PORT=${env.DEPLOY_PORT} \
          -e JENKINS_URL=http://localhost:8889 \
          -e JENKINS_PUBLIC_URL=http://vercingetorix.broadinstitute.org:8889 \
          -e JENKINS_JOB_PATH=job/run_sushi \
          -e PRISMSEQ_ROOT=/cmap/obelix/pod/prismSeq \
          -e SUSHI_UI_DB=/data/sushi_ui.db \
          -e SUSHI_UI_PRESETS=/data/presets.yml \
          -v ${env.DEPLOY_VOLUME}:/data \
          -v /cmap/obelix/pod/prismSeq:/cmap/obelix/pod/prismSeq \
          -v /local/jenkins/.clue_api_key:/local/jenkins/.clue_api_key:ro \
          ${image}
    """
}

/** Poll /api/health until the *expected commit* answers, or give up after ~30s.
 *
 *  Checking only that something answers is not enough. With --network=host, a
 *  container whose uvicorn died on EADDRINUSE leaves the previous occupant of
 *  the port replying 200 -- which once made this job report "production healthy"
 *  while the old hand-started instance was still serving. The commit is in the
 *  payload, so match on it.
 */
boolean healthyAt(String commit) {
    return sh(script: """
        for i in \$(seq 1 30); do
          if curl -fsS --max-time 3 http://localhost:${env.DEPLOY_PORT}/api/health 2>/dev/null \\
             | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("version",{}).get("commit") == "${commit}" else 1)' 2>/dev/null; then
            exit 0
          fi
          sleep 1
        done
        exit 1
    """, returnStatus: true) == 0
}

/** Why the deploy is unhealthy, in the console, without needing shell access. */
void diagnose() {
    sh """
        echo '--- container state ---'
        ${PODMAN} inspect -f 'status={{.State.Status}} exit={{.State.ExitCode}}' ${env.CONTAINER} 2>&1 || echo 'no such container'
        echo '--- container logs (last 50) ---'
        ${PODMAN} logs --tail 50 ${env.CONTAINER} 2>&1 || true
        echo '--- who holds :${env.DEPLOY_PORT} ---'
        (ss -lntp 2>/dev/null || true) | grep ':${env.DEPLOY_PORT} ' || echo 'nothing listening'
        echo '--- what answers there ---'
        curl -s --max-time 3 http://localhost:${env.DEPLOY_PORT}/api/health || true
        echo
    """
}
